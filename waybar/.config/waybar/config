// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    
    // Modules placement
    "modules-left": [
        "hyprland/workspaces",
        "custom/claude",
        "custom/magic",
        "custom/wireguard"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "battery",
        "clock"
    ],

    "custom/wireguard": {
    	"exec": "~/.local/bin/waybar-vpn",
	    "interval": 5,
	    "return-type": "json"
    },

    "hyprland/workspaces":{
        // normal workspaces stay icon-less blocks
        "format": "{icon}",
        "format-icons": { "default": "" }
    },

    // scratchpads: own modules, since show-special loses them when windows move on and off.
    // Icons from the Scratchpad Icons font in ~/.fonts (build-scratchpad-icons.py)
    "custom/claude": {
        "exec": "~/.config/waybar/scratchpad.py claude \ue000",  // Clawd
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"claude\")'"
    },
    "custom/magic": {
        "exec": "~/.config/waybar/scratchpad.py magic \ue001",  // rounded square
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"magic\")'"
    },

    "clock": {
        // zero-width space in Nerd Font: matches line height of icon modules so clock lines up
        "format": "<span font_family='JetBrainsMono Nerd Font'>\u200b</span>{:%a %H:%M}",
        "format-alt": "<span font_family='JetBrainsMono Nerd Font'>\u200b</span>{:%a %d/%m/%Y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "months": "<span font_family='Helvetica Neue' weight='bold' size='large' foreground='#FFFFFF'>{}</span>",
                "weekdays": "<span font_family='Helvetica Neue Calendar' weight='bold' foreground='#666666'>{}</span>",
                "days": "<span font_family='Helvetica Neue Calendar' weight='bold' foreground='#BBBBBB'>{}</span>",
                "today": "<span font_family='Helvetica Neue Calendar' weight='bold' background='#BBBBBB' foreground='#191919'><b>{}</b></span>"
            }
        }
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "{icon}",
        "format-full": "{icon}",
        "format-icons": [" ", " ", " ", " ", " "],
        "tooltip-format": "{capacity}%",
        "tooltip-format-charging": "{capacity}% · Charging",
        "tooltip-format-plugged": "{capacity}% · Full",
        "tooltip-format-full": "{capacity}% · Full"
    },
    "network": {
        "format-wifi": "   {essid}",
        "format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "",
        "format-bluetooth-muted": " ",
        "format-muted": "",
        "format-icons": {
            "headphone": " ",
            "phone": " ",
            "phone-muted": " ",
            "portable": " ",
            "default": [" ", " "]
        },
        "tooltip": false,
        "on-click": "pavucontrol",
    },
}

