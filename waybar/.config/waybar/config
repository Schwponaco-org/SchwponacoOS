// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    
    // Modules placement
    "modules-left": [
        "hyprland/workspaces",
        "custom/wireguard"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "battery",
        "clock"
    ],

    "custom/wireguard": {
    	"exec": "~/Scripts/WaybarVPN.sh",
	    "interval": 5,
	    "return-type": "json"
    },

    "hyprland/workspaces":{
        // normal workspaces stay icon-less blocks; scratchpads get an icon, keyed by name
        "format": "{icon}",
        "show-special": true,
        "format-icons": {
            // Scratchpad Icons: font in ~/.fonts built by build-scratchpad-icons.py, both glyphs at the Nerd icons' height
            "claude": "<span font_family='Scratchpad Icons'>\ue000</span>",  // Clawd
            "magic": "<span font_family='Scratchpad Icons'>\ue001</span>",   // rounded square
            "default": ""
        }
    },

    "clock": {
        // zero-width space in Nerd Font: matches line height of icon modules so clock lines up
        "format": "<span font_family='JetBrainsMono Nerd Font'>\u200b</span>{:%a %H:%M}",
        "format-alt": "<span font_family='JetBrainsMono Nerd Font'>\u200b</span>{:%a %d/%m/%Y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "months": "<span font_family='Helvetica Neue' weight='bold' size='large' foreground='#FFFFFF'>{}</span>",
                "weekdays": "<span font_family='Helvetica Neue Calendar' weight='bold' foreground='#666666'>{}</span>",
                "days": "<span font_family='Helvetica Neue Calendar' weight='bold' foreground='#BBBBBB'>{}</span>",
                "today": "<span font_family='Helvetica Neue Calendar' weight='bold' background='#BBBBBB' foreground='#191919'><b>{}</b></span>"
            }
        }
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "{icon}",
        "format-full": "{icon}",
        "format-icons": [" ", " ", " ", " ", " "],
        "tooltip-format": "{capacity}%",
        "tooltip-format-charging": "{capacity}% · Charging",
        "tooltip-format-plugged": "{capacity}% · Full",
        "tooltip-format-full": "{capacity}% · Full"
    },
    "network": {
        "format-wifi": "   {essid}",
        "format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "",
        "format-bluetooth-muted": " ",
        "format-muted": "",
        "format-icons": {
            "headphone": " ",
            "phone": " ",
            "phone-muted": " ",
            "portable": " ",
            "default": [" ", " "]
        },
        "tooltip": false,
        "on-click": "pavucontrol",
    },
}

