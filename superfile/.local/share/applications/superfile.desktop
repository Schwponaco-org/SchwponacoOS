[Desktop Entry]
# Opens folders in superfile, including KDE Connect's "Browse this device"; set as the default with:
#   xdg-mime default superfile.desktop inode/directory
# %u plus X-KDE-Protocols: KDE passes kdeconnect:// links through instead of downloading them.
# open-folder is in the scripts package (~/.local/bin, which must be on PATH).
Type=Application
Name=superfile
Exec=open-folder %u
MimeType=inode/directory;
X-KDE-Protocols=file,kdeconnect
NoDisplay=true
