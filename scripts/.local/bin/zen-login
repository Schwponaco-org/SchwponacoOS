#!/usr/bin/env python3
"""Zen with your logins and nothing else.

Every launch starts a fresh Zen profile in RAM (your normal Zen's user.js and extensions), puts in only the
cookies of the sites listed in ~/.config/zen-login/sites, and runs Zen. On exit it keeps those sites' own
cookies, encrypts them and deletes the whole profile: no history, cache or other site data survives.
A site marked "+storage" also keeps its local storage (not its cache or offline databases): Proton keeps
half of its login there.
The fresh profile is a copy of a base built once, without visiting any page, with the extensions already
installed: otherwise every launch is a first install, and Tridactyl opens its tutorial each time. The base
is rebuilt whenever your user.js or extensions change.

  zen-login [url ...]   start (asks for the passphrase when it needs to decrypt); while it's already
                        running, the urls open as tabs in that window instead
  zen-login --setup     create the gpg key (you pick the passphrase) and a starter sites file

Data:
  ~/.config/zen-login/sites          one domain per line, e.g. "github.com" or "proton.me +storage";
                                     subdomains are included. Not in the repo.
  ~/.local/share/zen-login/login.tar.gpg  the kept cookies (and storage), encrypted to the gpg key "zen-login"
  ~/.local/share/zen-login/base.tar        the base profile: settings and extensions only, nothing personal
  Zen's default profile (~/.config/zen/profiles.ini): user.js and extensions/*.xpi are copied from it
Needs gpg with a graphical pinentry, and zen-browser.
"""
import fcntl
import hashlib
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tarfile
import time

KEY = "zen-login"
SITES = os.path.expanduser("~/.config/zen-login/sites")
STORE = os.path.expanduser("~/.local/share/zen-login/login.tar.gpg")
BASE = os.path.expanduser("~/.local/share/zen-login/base.tar")
ZEN = os.path.expanduser("~/.config/zen")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PROFILE = os.path.join(RUNTIME, "zen-login")  # RAM; always the same path, so a copy of the base fits it
# left out of the base: anything a page could have touched, plus locks and caches
NOT_IN_BASE = ("cookies.sqlite", "sessionstore", "places.sqlite", "favicons.sqlite", "formhistory.sqlite",
               "cache2", "startupCache", "lock", ".parentlock", "storage/default/http", "zen-sessions")

# on top of the normal user.js: cookies must reach disk (RAM here) so they can be kept; nothing else
OVERRIDES = """
// zen-login: a normal (non-private) window so cookies are written; zen-login wipes the profile itself
user_pref("browser.privatebrowsing.autostart", false);
user_pref("privacy.sanitize.sanitizeOnShutdown", false);
user_pref("places.history.enabled", false);
user_pref("browser.cache.disk.enable", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("extensions.autoDisableScopes", 0);            // the copied extensions start enabled
user_pref("zen.welcome-screen.seen", true);              // fresh profile every time: skip first-run pages
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
"""


def sites():
    """{domain: keeps storage} from the sites file."""
    out = {}
    with open(SITES) as f:
        for line in f:
            words = line.split("#")[0].lower().split()
            if words:
                out[words[0].lstrip(".")] = "+storage" in words[1:]
    return out


def wanted(host, domains):
    host = host.lstrip(".").lower()
    return any(host == d or host.endswith("." + d) for d in domains)


def main_profile():
    inst = False
    for line in open(os.path.join(ZEN, "profiles.ini")):
        line = line.strip()
        if line.startswith("["):
            inst = line.startswith("[Install")
        elif inst and line.startswith("Default="):
            return os.path.join(ZEN, line.split("=", 1)[1])
    sys.exit("No Zen profile found; start Zen once first.")


def storage_to_keep(profile, domains):
    """Local storage folders of the +storage sites' own origins: storage/default/https+++<host>[+port].
    Names with "^" are partitioned or container copies and are left out, as are cache and offline data."""
    base = os.path.join(profile, "storage", "default")
    keep = [d for d, storage in domains.items() if storage]
    for name in sorted(os.listdir(base)) if keep and os.path.isdir(base) else []:
        host = name.split("+++", 1)[-1].split("+")[0]
        if name.startswith("https+++") and "^" not in name and wanted(host, keep):
            for part in (".metadata-v2", "ls"):
                if os.path.exists(os.path.join(base, name, part)):
                    yield os.path.join("storage", "default", name, part)


def keep_only_listed(db, out, domains):
    """Copy db to out with only the listed sites' own cookies (no partitioned ones), compacted so
    deleted cookies don't linger in free pages."""
    c = sqlite3.connect(db)
    rows = c.execute("select id, host, originAttributes from moz_cookies").fetchall()
    drop = [(i,) for i, host, attrs in rows if not wanted(host, domains) or "partitionKey" in attrs]
    c.executemany("delete from moz_cookies where id = ?", drop)
    c.commit()
    c.execute("vacuum into ?", (out,))
    c.close()
    return len(rows) - len(drop)


def fill(profile, main):
    """user.js (with the overrides) and the extensions, from your normal profile. Returns their hash."""
    h = hashlib.sha256()
    with open(os.path.join(main, "user.js"), "rb") as f:
        userjs = f.read() + OVERRIDES.encode()
    h.update(userjs)
    with open(os.path.join(profile, "user.js"), "wb") as f:
        f.write(userjs)
    ext = os.path.join(main, "extensions")
    os.makedirs(os.path.join(profile, "extensions"), exist_ok=True)
    for x in sorted(os.listdir(ext)) if os.path.isdir(ext) else []:
        if x.endswith(".xpi"):
            shutil.copy(os.path.join(ext, x), os.path.join(profile, "extensions", x))
            with open(os.path.join(ext, x), "rb") as f:
                h.update(x.encode() + f.read())
    return h.hexdigest()


def build_base(main):
    """Start Zen once, headless and on about:blank, so the extensions install; keep the result."""
    subprocess.run(["notify-send", "-a", "zen-login", "zen-login", "Setting up the base profile, a few seconds…"])
    shutil.rmtree(PROFILE, ignore_errors=True)
    os.makedirs(PROFILE)
    digest = fill(PROFILE, main)
    ids = {x[:-4] for x in os.listdir(os.path.join(PROFILE, "extensions"))}
    zen = subprocess.Popen(["zen-browser", "--headless", "--new-instance", "--profile", PROFILE, "about:blank"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(60):  # until every extension is registered and active
        time.sleep(1)
        try:
            with open(os.path.join(PROFILE, "extensions.json")) as f:
                active = {a["id"] for a in json.load(f)["addons"] if a.get("active")}
        except (OSError, ValueError, KeyError):
            continue
        if ids <= active:
            break
    time.sleep(5)  # let first-run work (uBlock's filter lists) finish
    zen.terminate()  # Zen shuts down cleanly on SIGTERM
    zen.wait(30)
    os.makedirs(os.path.dirname(BASE), exist_ok=True)
    with tarfile.open(BASE + ".new", "w") as tar:
        tar.add(PROFILE, ".", filter=lambda t: None if any(
            t.name[2:].startswith(n) for n in NOT_IN_BASE) else t)
    os.replace(BASE + ".new", BASE)
    with open(BASE + ".id", "w") as f:
        f.write(digest)


def setup():
    if subprocess.run(["gpg", "--list-secret-keys", KEY], capture_output=True).returncode != 0:
        print("Creating the gpg key; pick the passphrase you'll type when zen-login starts.")
        subprocess.run(["gpg", "--quick-generate-key", KEY, "ed25519", "default", "never"], check=True)
        fpr = subprocess.run(["gpg", "--list-keys", "--with-colons", KEY], capture_output=True, text=True).stdout
        fpr = next(l.split(":")[9] for l in fpr.splitlines() if l.startswith("fpr"))
        subprocess.run(["gpg", "--quick-add-key", fpr, "cv25519", "encr", "never"], check=True)
    if not os.path.exists(SITES):
        os.makedirs(os.path.dirname(SITES), exist_ok=True)
        with open(SITES, "w") as f:
            f.write("# Sites whose login cookies zen-login keeps (subdomains included)\ngithub.com\n")
    print(f"Ready. Edit {SITES}, then run zen-login.")


def run(urls):
    os.umask(0o077)  # everything zen-login writes is readable by you only
    domains = sites()
    lock = open(os.path.join(RUNTIME, "zen-login.lock"), "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        # already running: Zen hands urls given with the same --profile to that window
        if urls:
            sys.exit(subprocess.run(["zen-browser", "--profile", PROFILE, *urls]).returncode)
        sys.exit("zen-login is already running.")

    main = main_profile()
    profile = PROFILE
    try:
        os.makedirs(profile, exist_ok=True)
        check = os.path.join(profile, ".check")
        os.makedirs(check, exist_ok=True)
        current = fill(check, main)  # hash of today's user.js and extensions
        shutil.rmtree(check)
        try:
            with open(BASE + ".id") as f:
                fresh = f.read() == current
        except OSError:
            fresh = False
        if not fresh:
            build_base(main)
        shutil.rmtree(profile, ignore_errors=True)  # a leftover from a crash, or the build above
        os.makedirs(profile)
        with tarfile.open(BASE) as tar:
            tar.extractall(profile, filter="data")

        if os.path.exists(STORE):
            bundle = os.path.join(profile, "login.tar")
            subprocess.run(["gpg", "--quiet", "--batch", "--decrypt", "--output", bundle, STORE], check=True)
            with tarfile.open(bundle) as tar:
                tar.extractall(profile, filter="data")  # "data": nothing can land outside the profile
            os.remove(bundle)

        # --new-instance: separate from your normal Zen, but unlike --no-remote it still takes urls
        # from a second zen-login (above)
        subprocess.run(["zen-browser", "--new-instance", "--profile", profile, *urls])

        db = os.path.join(profile, "cookies.sqlite")
        if os.path.exists(db):
            clean = os.path.join(profile, "keep.sqlite")
            kept = keep_only_listed(db, clean, domains)
            bundle = os.path.join(profile, "login.tar")
            with tarfile.open(bundle, "w") as tar:
                tar.add(clean, "cookies.sqlite")
                stored = list(storage_to_keep(profile, domains))
                for path in stored:
                    tar.add(os.path.join(profile, path), path)
            os.makedirs(os.path.dirname(STORE), exist_ok=True)
            subprocess.run(["gpg", "--quiet", "--batch", "--yes", "--encrypt", "--recipient", KEY,
                            "--output", STORE + ".new", bundle], check=True)
            os.replace(STORE + ".new", STORE)  # the old file stays until the new one is complete
            origins = sorted({p.split(os.sep)[2] for p in stored})
            print(f"Kept {kept} cookies for {', '.join(domains)}" + (f", storage of {', '.join(origins)}" if origins else "") + ".")
    finally:
        shutil.rmtree(profile, ignore_errors=True)


if __name__ == "__main__":
    if sys.argv[1:2] == ["--setup"]:
        setup()
    else:
        run(sys.argv[1:])
