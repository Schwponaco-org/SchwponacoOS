#!/bin/sh
# Drag out a region: saves it to Pictures/Screenshots and copies it to the clipboard.
# Needs grim, slurp, wl-clipboard and libnotify (notify-send); the folder follows xdg-user-dirs.

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
file="$dir/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

region=$(slurp) || exit 0  # Esc while selecting: nothing to save
mkdir -p "$dir"
grim -g "$region" "$file" && wl-copy < "$file" && notify-send -a screenshot "Screenshot saved" "$file"
