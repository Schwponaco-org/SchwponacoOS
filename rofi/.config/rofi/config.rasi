configuration {
    /* "_prefix" first: combi hands unmatched typed text to its first mode ("!web search",
       "#github repo"); the odd name keeps combi's "!mode" shortcut from catching searches */
    modi: "drun,window,_prefix:~/.config/rofi/prefixes.sh";
    combi-modes: "_prefix,drun";
    combi-hide-mode-prefix: true;
    show-icons: false;
    terminal: "kitty";
    font: "Helvetica Neue Bold 35";
    drun-display-format: "{name}";
    show-modi: false;
}

@theme "~/.config/rofi/swag-theme.rasi"
